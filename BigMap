  const safeUrl=u=>{try{const x=new URL(u,location.origin);return /^https?:$/i.test(x.protocol)?x.href:null}catch{return null}};
  const parseYmd=s=>{const v=String(s||'').trim();let m=/^(\d{2})-(\d{2})-(\d{4})$/.exec(v);if(m)return Date.UTC(+m[3],+m[2]-1,+m[1]);m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(v);if(m)return Date.UTC(+m[1],+m[2]-1,+m[3]);return null};
  const parseRange=s=>{const p=String(s||'').split(/\s+to\s+/i);return{startMs:parseYmd(p[0]),endMs:parseYmd(p[1]||p[0])}};
  const todayUtc=()=>{const d=new Date();return Date.UTC(d.getFullYear(),d.getMonth(),d.getDate())};
  const pad2=n=>String(n).padStart(2,'0');
  const fmtDateMs=ms=>{const d=new Date(ms);return `${pad2(d.getUTCDate())}-${pad2(d.getUTCMonth()+1)}-${d.getUTCFullYear()}`};
  const fmtRange=(a,b)=>{const x=(a??b??Date.now());return a&&b&&a!==b?`${fmtDateMs(a)} - ${fmtDateMs(b)}`:fmtDateMs(x)};
  const hasCoords=(a,b)=>Number.isFinite(a)&&Number.isFinite(b)&&Math.abs(a)<=90&&Math.abs(b)<=180;
  const norm=v=>String(v||'').trim().toLowerCase();
  const normalizeCountry=v=>{
    const x=norm(v).replace(/\./g,'');
    const aliases={
      uk:'united kingdom',
      'great britain':'united kingdom',
      britain:'united kingdom',
      us:'united states',
      usa:'united states',
      'united states of america':'united states'
    };
    return aliases[x]||x;
  };
  const locationKey=(city,country)=>`${norm(city)||'unknown-city'}|${normalizeCountry(country)||'unknown-country'}`;

  const teacherRows=teachers.map((t,i)=>{const lat=t?.coordinates?.[0],lng=t?.coordinates?.[1],ok=hasCoords(lat,lng);const r={id:`t-${i}`,type:'teacher',name:String(t?.name||'Unnamed teacher'),city:String(t?.city||''),country:String(t?.country||''),style:String(t?.style||''),ig:safeUrl(t?.IG),website:safeUrl(t?.website),episodeNumber:t?.episode?.number?String(t.episode.number):'',episodeLink:safeUrl(t?.episode?.link),lat:ok?Number(lat):null,lng:ok?Number(lng):null};r.search=[r.name,r.city,r.country,r.style].join(' ').toLowerCase();return r});
  const eventRows=events.map((e,i)=>{const lat=Number(e?.lat),lng=Number(e?.lng),ok=hasCoords(lat,lng),rg=parseRange(e?.date);const r={id:`e-${i}`,type:'event',name:String(e?.name||'Unnamed event'),city:String(e?.city||''),country:String(e?.country||''),url:safeUrl(e?.url),rawDate:String(e?.date||''),startMs:rg.startMs,endMs:rg.endMs,lat:ok?lat:null,lng:ok?lng:null};r.search=[r.name,r.city,r.country,r.rawDate].join(' ').toLowerCase();return r});

  for(const t of teacherRows) t.locationKey=locationKey(t.city,t.country);
  for(const e of eventRows) e.locationKey=locationKey(e.city,e.country);

  const canonicalCoordsByLocation=new Map();
  for(const t of teacherRows){
    if(t.lat!=null && !canonicalCoordsByLocation.has(t.locationKey)) canonicalCoordsByLocation.set(t.locationKey,[t.lat,t.lng]);
  }
  for(const e of eventRows){
    if(e.lat!=null && !canonicalCoordsByLocation.has(e.locationKey)) canonicalCoordsByLocation.set(e.locationKey,[e.lat,e.lng]);
  }
  for(const t of teacherRows){
    const coords=canonicalCoordsByLocation.get(t.locationKey);
    if(coords){ [t.lat,t.lng]=coords; }
  }
  for(const e of eventRows){
    const coords=canonicalCoordsByLocation.get(e.locationKey);
    if(coords){ [e.lat,e.lng]=coords; }
  }

  const teacherById=new Map(teacherRows.map(r=>[r.id,r]));
  const eventById=new Map(eventRows.map(r=>[r.id,r]));
  const teacherGroups=new Map();
  for(const t of teacherRows){const k=t.locationKey;let g=teacherGroups.get(k);if(!g){g={city:t.city||'Unknown city',country:t.country||'',coords:t.lat!=null?[t.lat,t.lng]:null,ids:[]};teacherGroups.set(k,g)}if(!g.coords&&t.lat!=null)g.coords=[t.lat,t.lng];g.ids.push(t.id)}
  const eventGroups=new Map();
  for(const e of eventRows){if(e.lat==null)continue;const k=e.locationKey;let g=eventGroups.get(k);if(!g){g={city:e.city||'Unknown city',country:e.country||'',coords:[e.lat,e.lng],ids:[]};eventGroups.set(k,g)}g.ids.push(e.id)}

  const map=L.map('sj-map',{worldCopyJump:true,scrollWheelZoom:true}).setView([20,10],2);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',{subdomains:'abcd',maxZoom:20,attribution:'&copy; OpenStreetMap contributors &copy; CARTO'}).addTo(map);
  const teacherLayer=L.layerGroup().addTo(map),eventLayer=L.layerGroup().addTo(map);
  let teacherMarkerById=new Map(),eventMarkerById=new Map();

  const state={type:'all',query:'',showPast:false};
  const teacherColor=getComputedStyle(document.documentElement).getPropertyValue('--teacher').trim()||'#2f6da3';
  const cardsEl=document.getElementById('sj-cards'),titleEl=document.getElementById('sj-list-title'),noteEl=document.getElementById('sj-note');
  const searchEl=document.getElementById('sj-search'),showPastEl=document.getElementById('sj-show-past'),typeWrap=document.getElementById('sj-type'),fitBtn=document.getElementById('sj-fit');

  const mTeachers=()=>state.type==='event'?[]:teacherRows.filter(t=>!state.query||t.search.includes(state.query));
  const mEvents=()=>state.type==='teacher'?[]:eventRows.filter(e=>(state.showPast||!(e.endMs!=null&&e.endMs<todayUtc()))&&(!state.query||e.search.includes(state.query)));
  const popupTeachers=(g,ids)=>`<strong>${esc(g.city)}${g.country?`, ${esc(g.country)}`:''}</strong><ul>${ids.map(id=>{const t=teacherById.get(id);const links=[t.website?`<a href="${t.website}" target="_blank" rel="noopener noreferrer">Website</a>`:'',t.ig?`<a href="${t.ig}" target="_blank" rel="noopener noreferrer">Instagram</a>`:'',t.episodeLink?`<a href="${t.episodeLink}" target="_blank" rel="noopener noreferrer">Episode ${esc(t.episodeNumber)}</a>`:''].filter(Boolean).join(' · ');return `<li><strong>${esc(t.name)}</strong>${t.style?` <span class="sj-muted">(${esc(t.style)})</span>`:''}<br>${links||'<span class="sj-muted">No links</span>'}</li>`}).join('')}</ul>`;
  const popupEvents=(g,ids)=>`<strong>${esc(g.city)}${g.country?`, ${esc(g.country)}`:''}</strong><ul>${ids.map(id=>{const e=eventById.get(id);return `<li><strong>${esc(e.name)}</strong><br>${esc(fmtRange(e.startMs,e.endMs))}<br>${(e.url?`<a href="${e.url}" target="_blank" rel="noopener noreferrer">Event link</a>`:'<span class="sj-muted">No link</span>')}</li>`}).join('')}</ul>`;

  function renderMap(){teacherLayer.clearLayers();eventLayer.clearLayers();teacherMarkerById=new Map();eventMarkerById=new Map();const tSet=new Set(mTeachers().map(t=>t.id)),eSet=new Set(mEvents().map(e=>e.id));
    for(const g of teacherGroups.values()){const ids=g.ids.filter(id=>tSet.has(id));if(!ids.length||!g.coords)continue;const m=L.circleMarker(g.coords,{radius:ids.length>1?10:8,color:'#ffffff',weight:2,fillColor:teacherColor,fillOpacity:.94}).bindPopup(popupTeachers(g,ids),{maxWidth:360});m._teacherIds=ids;m.addTo(teacherLayer);ids.forEach(id=>teacherMarkerById.set(id,m));}
    for(const g of eventGroups.values()){const ids=g.ids.filter(id=>eSet.has(id));if(!ids.length)continue;const c=ids.length;const icon=L.divIcon({className:'',html:`<div class="sj-event-pin">${c>1?c:'E'}</div>`,iconSize:[24,24],iconAnchor:[12,12]});const m=L.marker(g.coords,{icon}).bindPopup(popupEvents(g,ids),{maxWidth:360});m._eventIds=ids;m.addTo(eventLayer);ids.forEach(id=>eventMarkerById.set(id,m));}
  }

  function listItems(){const q=!!state.query,out=[];if(q){mTeachers().forEach(t=>out.push({...t,hasCoords:t.lat!=null}));mEvents().forEach(e=>out.push({...e,hasCoords:e.lat!=null}));}else{const b=map.getBounds();teacherLayer.eachLayer(m=>{if(!b.contains(m.getLatLng()))return;(m._teacherIds||[]).forEach(id=>out.push({...teacherById.get(id),hasCoords:true}))});eventLayer.eachLayer(m=>{if(!b.contains(m.getLatLng()))return;(m._eventIds||[]).forEach(id=>out.push({...eventById.get(id),hasCoords:true}))});}
    out.sort((a,b)=>a.type!==b.type?(a.type==='event'?-1:1):(a.type==='event'?((a.startMs??Infinity)-(b.startMs??Infinity)||a.city.localeCompare(b.city)||a.name.localeCompare(b.name)):(a.city.localeCompare(b.city)||a.name.localeCompare(b.name))));
    return out;
  }

  function renderList(){const items=listItems(),q=!!state.query,unmapped=q?items.filter(x=>!x.hasCoords).length:0;titleEl.textContent=q?`Search results (${items.length})`:`Items in view (${items.length})`;noteEl.textContent=unmapped?`${unmapped} result(s) have no coordinates and cannot be pinned on the map.`:'';if(!items.length){cardsEl.innerHTML='<p class="sj-muted">No results.</p>';return;}
    cardsEl.innerHTML=items.map(x=>{if(x.type==='teacher'){const links=[];if(x.website)links.push(`<a href="${x.website}" target="_blank" rel="noopener noreferrer">Website</a>`);if(x.ig)links.push(`<a href="${x.ig}" target="_blank" rel="noopener noreferrer">Instagram</a>`);if(x.episodeLink)links.push(`<a href="${x.episodeLink}" target="_blank" rel="noopener noreferrer">Episode ${esc(x.episodeNumber||'')}</a>`);return `<div class="sj-card sj-card--teacher" data-type="teacher" data-id="${esc(x.id)}"><span class="sj-card-kind">Teacher</span><h3>${esc(x.name)}</h3><p><strong>Location:</strong> ${esc(x.city)}${x.country?`, ${esc(x.country)}`:''}</p>${x.style?`<p><strong>Style:</strong> ${esc(x.style)}</p>`:''}${!x.hasCoords?`<p class="sj-muted">No map coordinates</p>`:''}<p class="sj-links">${links.join(' ')||'<span class="sj-muted">No links</span>'}</p></div>`;}const eventLink=x.url?`<a href="${x.url}" target="_blank" rel="noopener noreferrer">Event link</a>`:'<span class="sj-muted">No link</span>';return `<div class="sj-card sj-card--event" data-type="event" data-id="${esc(x.id)}"><span class="sj-card-kind">Event</span><h3>${esc(x.name)}</h3><p><strong>Date:</strong> ${esc(fmtRange(x.startMs,x.endMs))}</p><p><strong>Location:</strong> ${esc(x.city)}${x.country?`, ${esc(x.country)}`:''}</p>${!x.hasCoords?`<p class="sj-muted">No map coordinates</p>`:''}<p class="sj-links">${eventLink}</p></div>`;}).join('');
  }

  const fitVisible=()=>{const pts=[];teacherLayer.eachLayer(m=>pts.push(m.getLatLng()));eventLayer.eachLayer(m=>pts.push(m.getLatLng()));if(pts.length)map.fitBounds(L.latLngBounds(pts).pad(.2));};
  const renderAll=()=>{renderMap();renderList();};
  const debounce=(fn,ms)=>{let t;return()=>{clearTimeout(t);t=setTimeout(fn,ms)}};

  typeWrap.addEventListener('click',e=>{const b=e.target.closest('button[data-type]');if(!b)return;state.type=b.dataset.type;[...typeWrap.querySelectorAll('button')].forEach(x=>x.setAttribute('aria-pressed',String(x===b)));renderAll();fitVisible();});
  showPastEl.addEventListener('change',()=>{state.showPast=showPastEl.checked;renderAll();});
  searchEl.addEventListener('input',debounce(()=>{state.query=searchEl.value.trim().toLowerCase();renderAll();},180));
  map.on('moveend',()=>{if(!state.query)renderList();});
  cardsEl.addEventListener('click',e=>{if(e.target.closest('a'))return;const c=e.target.closest('.sj-card');if(!c)return;const m=c.dataset.type==='teacher'?teacherMarkerById.get(c.dataset.id):eventMarkerById.get(c.dataset.id);if(m){map.panTo(m.getLatLng());m.openPopup();}});
  fitBtn.addEventListener('click',fitVisible);

  showPastEl.checked=false;state.showPast=false;renderAll();fitVisible();
});
</script>
