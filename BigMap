<!-- Combined Dance Map (Squarespace-ready) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:wght@500;700&family=Manrope:wght@400;500;600;700&display=swap');
:root{
  --teacher:#2f6da3;
  --teacher-soft:#e5f0f9;
  --event:#b86a2a;
  --event-soft:#f9ecde;
  --ink:#1f2937;
  --muted:#6b7280;
  --line:#d9dfeb;
  --panel:#ffffff;
  --surface:#f6f2ea;
}
#sj-wrap{
  font-family:'Manrope',sans-serif;
  color:var(--ink);
  background:
    radial-gradient(1100px 420px at 15% -20%, #ece2d2 0%, transparent 60%),
    radial-gradient(1200px 360px at 100% -25%, #e7edf8 0%, transparent 65%),
    var(--surface);
  border:1px solid #e6e0d3;
  border-radius:20px;
  padding:clamp(12px,2vw,20px);
}
#sj-head{
  position:sticky;
  top:0;
  z-index:40;
  padding:10px;
  margin:-10px -10px 14px;
  background:rgba(246,242,234,.86);
  backdrop-filter:blur(8px);
  border-bottom:1px solid #e8e0cf;
}
.sj-title{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.sj-title h1{margin:0;font:700 clamp(1.4rem,2.4vw,2rem)/1.1 'Fraunces',serif;letter-spacing:.2px}
.sj-title p{margin:0;color:var(--muted);font-size:14px}
.sj-controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
#sj-search{
  flex:1 1 300px;
  min-width:220px;
  padding:11px 13px;
  border:1px solid #ccd5e4;
  border-radius:12px;
  background:#fff;
}
#sj-search:focus{outline:none;border-color:#8ca9ca;box-shadow:0 0 0 3px rgba(47,109,163,.15)}
#sj-type{
  display:inline-flex;
  gap:4px;
  padding:4px;
  border:1px solid #ccd5e4;
  background:#fff;
  border-radius:12px;
}
#sj-type button{
  padding:8px 12px;
  border:0;
  background:transparent;
  border-radius:9px;
  color:#334155;
  font-weight:600;
  cursor:pointer;
  transition:.18s ease;
}
#sj-type button:hover{background:#edf2f9}
#sj-type button[aria-pressed="true"]{background:#1e2d3f;color:#fff}
.sj-toggle{
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:8px 10px;
  border:1px solid #ccd5e4;
  border-radius:12px;
  background:#fff;
  color:#334155;
  font-size:14px;
}
#sj-fit{
  border:1px solid #c5cfdf;
  background:#fff;
  color:#334155;
  padding:9px 12px;
  border-radius:12px;
  cursor:pointer;
  font-weight:600;
  transition:.18s ease;
}
#sj-fit:hover{background:#eef3f9;border-color:#9fb0cb}
.sj-legend{margin-top:10px;display:flex;gap:18px;flex-wrap:wrap;font-size:13px;color:#4b5563}
.sj-key{display:inline-flex;align-items:center;gap:7px}
.sj-key-dot,.sj-key-square{width:12px;height:12px;border:2px solid #fff;box-shadow:0 0 0 1px #cad4e2}
.sj-key-dot{border-radius:999px;background:var(--teacher)}
.sj-key-square{background:var(--event);border-radius:3px}
#sj-main{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.95fr);gap:16px}
#sj-map-shell{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:8px;box-shadow:0 10px 24px rgba(28,38,64,.07)}
#sj-map{height:560px;border:1px solid #d7deeb;border-radius:12px;overflow:hidden}
#sj-list-panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:14px;max-height:576px;overflow:auto;box-shadow:0 10px 24px rgba(28,38,64,.07)}
#sj-list-title{margin:0 0 6px;font:600 1.05rem/1.2 'Manrope',sans-serif}
#sj-note{margin:0 0 12px}
.sj-card{border:1px solid #d9dfeb;border-radius:13px;padding:12px;margin:0 0 10px;background:linear-gradient(180deg,#fff,#fdfdfd);box-shadow:0 2px 8px rgba(28,38,64,.04);cursor:pointer;transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease}
.sj-card:hover{transform:translateY(-1px);box-shadow:0 9px 18px rgba(28,38,64,.09)}
.sj-card.sj-card--teacher{border-left:4px solid var(--teacher)}
.sj-card.sj-card--event{border-left:4px solid var(--event)}
.sj-card-kind{display:inline-block;font-size:11px;letter-spacing:.04em;font-weight:700;text-transform:uppercase;border-radius:999px;padding:3px 8px;margin-bottom:7px}
.sj-card--teacher .sj-card-kind{background:var(--teacher-soft);color:#1f4d73}
.sj-card--event .sj-card-kind{background:var(--event-soft);color:#744217}
.sj-card h3{margin:0 0 7px;font-size:16px;line-height:1.25}
.sj-card p{margin:3px 0;font-size:14px;color:#334155}
.sj-links{margin-top:8px}
.sj-links a{color:#2f4e75;font-size:13px;text-decoration:none;margin-right:10px;border-bottom:1px dotted rgba(47,78,117,.4)}
.sj-links a:hover{color:#1e3755;border-bottom-color:#1e3755}
.sj-muted{color:var(--muted)}
#sj-wrap .leaflet-popup-content{font-family:'Manrope',sans-serif}
.sj-event-pin{width:22px;height:22px;border-radius:4px;border:2px solid #fff;background:var(--event);color:#fff;display:flex;align-items:center;justify-content:center;font:700 10px/1 'Manrope',sans-serif;box-shadow:0 5px 12px rgba(41,48,66,.25)}
@media (max-width:980px){
  #sj-main{grid-template-columns:1fr}
  #sj-map{height:58vh;min-height:360px}
  #sj-list-panel{max-height:none;overflow:visible;border-radius:14px}
}
@media (max-width:620px){
  .sj-title p{width:100%}
  #sj-head{margin:-10px -10px 10px}
  .sj-controls{gap:6px}
  #sj-type button{padding:7px 9px;font-size:13px}
  .sj-toggle,#sj-fit{font-size:13px}
}
</style>
